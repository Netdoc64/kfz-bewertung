{
  "name": "kfz-bewertung",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "openapi": "npm run openapi -w @kfz/api",
    "test": "npm run test --workspaces --if-present",
    "coverage": "npm run coverage --workspaces --if-present",
    "dev:api": "npm run dev -w @kfz/api",
    "einrichten": "npm run einrichten -w @kfz/betrieb"
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "^4.1.12",
    "typescript": "^5.6.3"
  }
}
