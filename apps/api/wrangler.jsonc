{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kfz-bewertung-api",
  // VardiFlowers-Cloudflare-Konto (kein Geheimnis); damit braucht der Deploy nur das Token.
  "account_id": "a8ab6057e5dd95df1998fff2f5c1c955",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kfz-bewertung",
      // Aus `npm run einrichten` (kein Geheimnis).
      "database_id": "b34cf1bb-1688-47f3-839f-5daa02594cf7",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [{ "binding": "BEWERTUNG_QUEUE", "queue": "bewertung" }],
    "consumers": [
      // max_retries = Plattform-Standard laut Doku. Der fachliche Wert quelle.maxVersuche wird zur Laufzeit gelesen.
      { "queue": "bewertung", "max_retries": 3, "dead_letter_queue": "bewertung-dead-letter" },
      // Dead-Letter-Queue hat einen eigenen Consumer, damit Nachrichten sichtbar werden.
      { "queue": "bewertung-dead-letter", "max_retries": 0 }
    ]
  },
  "triggers": { "crons": ["*/15 * * * *"] },
  "send_email": [{ "name": "EMAIL" }],
  "r2_buckets": [{ "binding": "BERICHTE", "bucket_name": "kfz-bewertung-berichte" }],
  // Admin-Web: Build von apps/admin. run_worker_first = der Worker prüft Access vor jeder Auslieferung.
  "build": { "command": "npm run build -w @kfz/admin", "cwd": "../.." },
  "assets": { "directory": "../admin/dist", "binding": "ASSETS", "run_worker_first": true },
  // Oberste Ebene = Produktion. Ein `wrangler deploy` ohne --env ist damit sicher:
  // die Access-Prüfung ist an, und ohne ACCESS_* verweigert der Admin-Bereich.
  "vars": {
    "UMGEBUNG": "produktion",
    // Access-App „kfz Admin“ (Zero Trust). Beides keine Geheimnisse.
    "ACCESS_TEAM_DOMAIN": "vardiflowers.cloudflareaccess.com",
    "ACCESS_AUD": "5e9b791a9ef2a2b4078293f4ba4b6ee0519f29bf3e7174798d08467e0193d6d2"
  },
  "env": {
    // Nur lokal (`npm run dev`, Tests). Überspringt die Access-Prüfung.
    "entwicklung": {
      "vars": {
        "UMGEBUNG": "entwicklung",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kfz-bewertung-dev",
          "database_id": "c3be9323-d6be-41b1-bdf9-2f7911e74bc5",
          "migrations_dir": "migrations"
        }
      ],
      "queues": {
        "producers": [{ "binding": "BEWERTUNG_QUEUE", "queue": "bewertung-dev" }],
        "consumers": [
          // max_retries = Plattform-Standard laut Doku. Der fachliche Wert quelle.maxVersuche wird zur Laufzeit gelesen.
          { "queue": "bewertung-dev", "max_retries": 3, "dead_letter_queue": "bewertung-dead-letter-dev" },
          // Dead-Letter-Queue hat einen eigenen Consumer, damit Nachrichten sichtbar werden.
          { "queue": "bewertung-dead-letter-dev", "max_retries": 0 }
        ]
      },
      "triggers": { "crons": ["*/15 * * * *"] },
      "send_email": [{ "name": "EMAIL" }],
      "r2_buckets": [{ "binding": "BERICHTE", "bucket_name": "kfz-bewertung-berichte-dev" }]
    },
    // Vorschau: eigene Ressourcen, nichts mit Produktion oder entwicklung geteilt. Die Access-Prüfung
    // ist aktiv (nur `entwicklung` überspringt sie); ohne ACCESS_* verweigert der Admin-Bereich.
    "vorschau": {
      "vars": {
        "UMGEBUNG": "vorschau",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kfz-bewertung-vorschau",
          // Aus `npm run einrichten` (kein Geheimnis).
          "database_id": "91c508eb-325b-4b8e-ad35-5a602ea8bbd5",
          "migrations_dir": "migrations"
        }
      ],
      "queues": {
        "producers": [{ "binding": "BEWERTUNG_QUEUE", "queue": "bewertung-vorschau" }],
        "consumers": [
          { "queue": "bewertung-vorschau", "max_retries": 3, "dead_letter_queue": "bewertung-dead-letter-vorschau" },
          // Dead-Letter-Queue hat einen eigenen Consumer, damit Nachrichten sichtbar werden.
          { "queue": "bewertung-dead-letter-vorschau", "max_retries": 0 }
        ]
      },
      "triggers": { "crons": ["*/15 * * * *"] },
      "send_email": [{ "name": "EMAIL" }],
      "r2_buckets": [{ "binding": "BERICHTE", "bucket_name": "kfz-bewertung-berichte-vorschau" }],
      "build": { "command": "npm run build -w @kfz/admin", "cwd": "../.." },
      "assets": { "directory": "../admin/dist", "binding": "ASSETS", "run_worker_first": true }
    }
  }
}
