    "/api/gesundheit": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Gesundheitsprüfung inklusive Datenbank",
        "description": "Ohne Anmeldung.",
        "responses": {
          "2XX": {
            "description": "Erfolg"
          },
          "default": {
            "description": "Fehler im einheitlichen Fehlerformat (Code, Nachricht, Korrelations-ID)"
          }
        }
      }
    },
    "/api/anfragen": {
      "post": {
        "tags": [
          "Formular"
        ],
        "summary": "Anfrage aus dem Webformular anlegen",
        "description": "Ohne Anmeldung.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "kontakt": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 200
                  },
                  "sprache": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 10
                  },
                  "fahrzeug": {
                    "type": "object",
                    "properties": {
                      "marke": {
                        "type": "string",
                        "minLength": 1
                      },
                      "modell": {
                        "type": "string",
                        "minLength": 1
                      },
                      "variante": {
                        "type": "string"
                      },
                      "fin": {
                        "type": "string",
                        "pattern": "^[A-HJ-NPR-Z0-9]{17}$"
                      },
                      "hsn": {
                        "type": "string",
                        "pattern": "^\\d{4}$"
                      },
                      "tsn": {
                        "type": "string",
                        "pattern": "^[A-Z0-9]{3}$"
                      },
                      "erstzulassung": {
                        "type": "string",
                        "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
                      },
                      "kilometer": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "leistungKw": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "kraftstoff": {
                        "type": "string",
                        "enum": [
                          "benzin",
                          "diesel",
                          "elektro",
                          "hybrid",
                          "plugin_hybrid",
                          "lpg",
                          "cng",
                          "wasserstoff",
                          "sonstige"
                        ]
                      },
                      "getriebe": {
                        "type": "string",
                        "enum": [
                          "manuell",
                          "automatik",
                          "halbautomatik"
                        ]
                      },
                      "zustand": {
                        "type": "string",
                        "enum": [
                          "unfallfrei",
                          "repariert",
                          "beschaedigt",
                          "nicht_fahrbereit"
                        ]
                      },
                      "vorbesitzer": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "scheckheft": {
                        "type": "boolean"
                      },
                      "huRestMonate": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "akkuSohProzent": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "ausstattung": {
                        "default": [],
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "farbe": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "marke",
                      "modell"
                    ]
                  },
                  "kennzeichen": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 15
                  },
                  "nachricht": {
                    "type": "string",
                    "maxLength": 5000
                  }
                },
                "required": [
                  "name",
                  "kontakt",
                  "fahrzeug"
                ]
              }
            }
          }
        },
        "responses": {
          "2XX": {
            "description": "Erfolg"
          },
          "default": {
            "description": "Fehler im einheitlichen Fehlerformat (Code, Nachricht, Korrelations-ID)"
          }
        }
      }
    },
